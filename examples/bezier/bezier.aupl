class Main

static Window win
static Renderer renderer

static void main() {
	win = Window(500, 500, "Bezier")
	Viewport viewport = win.viewport
	renderer = Renderer(viewport)

	Curve2D curve(
		vec2(50.0, 50.0),
		vec2(450.0, 50.0),
		vec2(50.0, 450.0),
		vec2(450.0, 450.0)
	)

	Scene scene()
	viewport.scene = scene

	Node root()
	scene.root = root

	root.add_child(curve)

	while not win.should_close() {
		u64 t1 = Time.sys_usec()
		u64 t2 = Time.sys_usec()

		while t2 - t1 < 1666 {
			t2 = Time.sys_usec()
		}
		
		renderer.render()
		win.poll_events()
	}
}